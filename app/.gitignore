# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Generated data — bulky, served from GCS in production. Keep meta/*.json.
# Matches the real dirs, the local-dev symlinks to ../pipeline/build, and the
# .sample backups (no trailing slash so symlinks are ignored too).
public/data/gene
public/data/gene.sample
public/data/phenotype
public/data/phenotype.sample
public/data/variant
public/data/variant.sample
public/data/meta/*.parquet
# Regenerated from `git log` on every dev/build (predev/prebuild) — committing
# it would go stale the instant another commit lands. See generate-changelog.js.
public/data/meta/changelog.json
public/data/_tmp/

